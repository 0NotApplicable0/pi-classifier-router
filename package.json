{
  "name": "@ejstembler/pi-classifier-router",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Classifier-driven model router for pi and Oh My Pi (omp): routes each prompt to a model using Jev (TypeSafe) or Laya typed decisions, with circuit breaking and fallback chains",
  "main": "src/index.ts",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "pi-package",
    "omp-extension",
    "pi-extension",
    "jev",
    "laya",
    "router"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "python",
    "examples",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@types/node": "^24.13.6",
    "typescript": "^5.9.0"
  }
}
